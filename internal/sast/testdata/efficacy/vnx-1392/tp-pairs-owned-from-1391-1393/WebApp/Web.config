<?xml version="1.0"?>
<configuration>
  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx">
        <credentials passwordFormat="Clear">
~>          <user name="admin" password="admin" />
        </credentials>
      </forms>
    </authentication>
  </system.web>
  <connectionStrings>
~>    <add name="Main" connectionString="Server=db;Database=shop;User Id=sa;Password=password;" />
  </connectionStrings>
</configuration>
