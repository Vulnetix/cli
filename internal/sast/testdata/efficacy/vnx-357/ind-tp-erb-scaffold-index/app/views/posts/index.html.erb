<h1>Posts</h1>
<table>
  <% @posts.each do |post| %>
    <tr>
      <td><%= post.title %></td>
      <td><%= link_to 'Show', post %></td>
      <td><%= link_to 'Edit', edit_post_path(post) %></td>
~>      <td><%= link_to 'Destroy', post, method: :delete %></td>
    </tr>
  <% end %>
</table>
<%= link_to 'New Post', new_post_path %>
