<% @users.each do |user| %>
  <tr>
    <td><%= user.email %></td>
    <td>
~>      <%= link_to "Delete",
            admin_user_path(user),
            method: :delete,
            class: "text-red" %>
    </td>
    <td>
~>      <%= button_to admin_user_path(user), method: :delete, class: "icon" do %>
        <i class="trash"></i>
      <% end %>
    </td>
  </tr>
<% end %>
