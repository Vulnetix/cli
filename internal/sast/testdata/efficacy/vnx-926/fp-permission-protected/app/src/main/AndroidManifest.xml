<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.app">
    <permission android:name="com.example.app.permission.SYNC" android:protectionLevel="signature" />
    <application>
        <service
            android:name=".JobsService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <provider
            android:name=".DataProvider"
            android:authorities="com.example.app.data"
            android:exported="true"
            android:readPermission="com.example.app.permission.SYNC"
            android:writePermission="com.example.app.permission.SYNC" />
        <receiver android:name=".SyncReceiver" android:exported="true"
            android:permission="com.example.app.permission.SYNC">
        </receiver>
    </application>
</manifest>
