<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="Weather"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://acme.example/weather"
    targetNamespace="http://acme.example/weather">
  <wsdl:types>
    <xs:schema targetNamespace="http://acme.example/weather">
      <xs:element name="ForecastRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="city" type="xs:string" default="London"/>
            <xs:element name="password" type="xs:string"/>
            <xs:element name="units" type="xs:string" fixed="metric"/>
            <xs:element name="token" type="xs:string" default=""/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:portType name="WeatherPort">
    <wsdl:operation name="getForecast"/>
    <wsdl:operation name="changePassword"/>
    <wsdl:operation name="getPasswordPolicy"/>
    <wsdl:operation name="testConnection"/>
    <wsdl:operation name="executeOrder"/>
  </wsdl:portType>
  <wsdl:service name="Weather">
    <wsdl:port name="WeatherPort" binding="tns:WeatherBinding">
      <soap:address location="https://weather.acme.example/ws"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
