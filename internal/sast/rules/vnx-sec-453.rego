	finding := {
		"rule_id": metadata.id,
		"message": "SendGrid subuser API key found; revoke it in the SendGrid dashboard under Settings \u003e API Keys for that subuser",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
