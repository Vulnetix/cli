		"rule_id": metadata.id,
		"message": "Vimeo access token found; revoke it in the Vimeo developer app settings and generate a new token",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
