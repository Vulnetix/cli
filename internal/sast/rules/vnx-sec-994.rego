_pattern := `(?i)(?:huobi|htx)[a-z0-9_]*(?:access[_-]?key|api[_-]?key|key)\s*[:=]\s*['"]?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})['"]?`
