package vulnetix.rules.vnx_sec_936

import rego.v1
import data.vulnetix.lib.secrets

# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-936",
	"name": "Soracom auth/API key",
	"description": "A Soracom API auth key was found. Soracom keys are prefixed with keyId-/secret- or appear as an apiKey/token assignment authorizing SIM and resource management via the Soracom API.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/saas/#vnx-sec-936",
	"languages": [],
	"severity": "high",
	"level": "error",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.001"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:H/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:H/DI:H/EX:H/EC:N/P:H",
	"tags": ["secrets", "soracom", "saas"],
}

_pattern := `(?i)soracom[a-z0-9_]*(?:auth[_-]?key|api[_-]?key|secret|token|key)[a-z0-9_]*\s*[:=]\s*['"]?((?:secret-|keyId-)?[A-Za-z0-9]{24,})['"]?`
_keywords := ["soracom"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	secrets.high_entropy(token, 3.6)
	finding := {
		"rule_id": metadata.id,
		"message": "Soracom auth key found; delete the AuthKey in the Soracom console under Security \u003e Auth Keys and rotate credentials",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
