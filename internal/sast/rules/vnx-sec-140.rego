package vulnetix.rules.vnx_sec_140

import rego.v1
import data.vulnetix.lib.secrets

# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-140",
	"name": "Aiven API token (aivenv1 / context)",
	"description": "An Aiven API token assigned to a context keyword was found. Aiven tokens grant access to manage the account's managed database and streaming services.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/cloud/#vnx-sec-140",
	"languages": [],
	"severity": "critical",
	"level": "error",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.001"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:C/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:C/DI:H/EX:H/EC:N/P:W",
	"tags": ["secrets", "aiven", "cloud"],
}

_pattern := `(?i)(?:aiven)[a-z0-9_]*(?:token|api[_-]?key)\s*[:=]\s*['"]?([A-Za-z0-9+/=_-]{40,})['"]?`
_keywords := ["aiven"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	secrets.high_entropy(token, 4)
	finding := {
		"rule_id": metadata.id,
		"message": "Aiven API token found; revoke it in the Aiven console under User Information \u003e Authentication tokens and create a new one",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
