package vulnetix.rules.vnx_sec_1118

import rego.v1
import data.vulnetix.lib.secrets

# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-1118",
	"name": "Flickr API key",
	"description": "A Flickr API key (32-character hex) was found. It authorizes Flickr API photo search and read access under the app rate limits.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/saas/#vnx-sec-1118",
	"languages": [],
	"severity": "medium",
	"level": "warning",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.001"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:M/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:M/DI:H/EX:M/EC:N/P:C",
	"tags": ["secrets", "flickr", "saas"],
}

_pattern := `(?i)flickr[a-z0-9_]*(?:api)?[_-]?key\s*[:=]\s*['"]?([0-9a-f]{32})['"]?`
_keywords := ["flickr", "apikey"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	secrets.high_entropy(token, 3.5)
	finding := {
		"rule_id": metadata.id,
		"message": "Flickr API key found; regenerate the app key and secret in the Flickr App Garden",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
