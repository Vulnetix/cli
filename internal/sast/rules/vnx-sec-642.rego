package vulnetix.rules.vnx_sec_642

import rego.v1
import data.vulnetix.lib.secrets

# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-642",
	"name": "RSA private key block",
	"description": "A PEM RSA private key block (BEGIN RSA PRIVATE KEY header) was found. It is the private half of an RSA key pair usable for TLS, SSH or signing.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/private-keys/#vnx-sec-642",
	"languages": [],
	"severity": "critical",
	"level": "error",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.004"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:C/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:C/DI:H/EX:H/EC:N/P:W",
	"tags": ["secrets", "rsa", "private-keys"],
}

_pattern := `(-----BEGIN RSA PRIVATE KEY-----)(?:\s*["']?,?\s*$|(?:(?:\\r)?\\n|\s)?[A-Za-z0-9+/=]{16})`
_keywords := ["begin", "private key", "rsa"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	finding := {
		"rule_id": metadata.id,
		"message": "RSA private key found; remove it from the repo and rotate the key pair and any certificates it backs",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
