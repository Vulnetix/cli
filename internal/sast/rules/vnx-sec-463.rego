package vulnetix.rules.vnx_sec_463

import rego.v1
import data.vulnetix.lib.secrets

# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-463",
	"name": "Customer.io tracking site/API key pair",
	"description": "A Customer.io tracking API key (the secret half of the site_id/api_key Basic Auth pair) was found near a customerio track assignment.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/communication/#vnx-sec-463",
	"languages": [],
	"severity": "high",
	"level": "error",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.001"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:H/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:H/DI:H/EX:H/EC:N/P:H",
	"tags": ["secrets", "customerio", "communication"],
}

_pattern := `(?i)(?:cio|customer[._]?io)[a-z0-9_]*(?:track[_-]?api[_-]?key|tracking[_-]?key|track[_-]?key)[a-z0-9_]*\s*[:=]\s*['"]?([a-f0-9]{20,40})['"]?`
_keywords := ["customer.io", "customerio", "cio", "track"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	secrets.high_entropy(token, 3.3)
	finding := {
		"rule_id": metadata.id,
		"message": "Customer.io tracking API key found; rotate it in the Customer.io workspace settings under API Credentials \u003e Tracking API Keys",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
