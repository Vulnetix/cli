# SPDX-License-Identifier: Apache-2.0
package vulnetix.rules.vnx_1101

import rego.v1

import data.vulnetix.helpers

metadata := {
	"id": "VNX-1101",
	"name": "Reliance on Runtime Component in Generated Code",
	"description": "A generated Java or Kotlin source file (one carrying, before its first type declaration, a generator header such as 'This file was generated by', 'Auto-generated', 'Code generated ... DO NOT EDIT', or a @Generated annotation) imports or names a package from the Java EE modules that were removed from the JDK in Java 11 (JEP 320): javax.xml.bind (JAXB), javax.xml.ws, javax.jws and javax.xml.soap (JAX-WS/SAAJ), javax.activation, javax.annotation.Generated/PostConstruct/PreDestroy/Resource, and CORBA (org.omg.*, javax.rmi.CORBA). The generated code then cannot run without a runtime component the platform no longer ships. Reported: each import or fully qualified use. Not reported: when the project's pom.xml or Gradle build declares the replacement runtime (jaxb-api, jaxb-runtime, jaxws-api, jaxws-rt, javax.annotation-api, javax.activation, saaj, the jakarta.* API artifacts), hand-written code (no generator marker in the header; a comment further down that mentions generated classes does not count), the jakarta.* and javax.annotation.processing.Generated replacements, other generator runtimes a build declares explicitly (protobuf, Thrift, ANTLR), and the package names inside strings or comments.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/vnx-1101/",
	"languages": ["java", "kotlin"],
	"severity": "low",
	"level": "note",
	"kind": "sast",
	"cwe": [1101],
	"capec": ["CAPEC-66"],
	"attack_technique": ["T1190"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:L/AP:RU/AL:S/IC:N/FC:LT/RP:RU/RL:S/AV:L/AS:N/IN:A/SC:A/BI:L/DI:H/EX:L/EC:N/P:L",
	"tags": ["generated-code", "runtime-dependency", "java", "cwe-1101"],
}

# Packages of the modules JEP 320 removed from the JDK in Java 11.
_removed_re := `\b(?:javax\.(?:xml\.bind|xml\.ws|jws|xml\.soap|activation|activity|rmi\.CORBA)\b|javax\.annotation\.(?:Generated|PostConstruct|PreDestroy|Resources?)\b|javax\.annotation\.\*|org\.omg\.(?:CORBA|CosNaming|PortableServer|PortableInterceptor|IOP|Dynamic|DynamicAny|Messaging|SendingContext|stub)\b)`

_gate_re := `javax\.(?:xml\.bind|xml\.ws|jws|xml\.soap|activation|activity|rmi\.CORBA|annotation)|org\.omg\.`

_marker_re := `(?i)(?:generated by|auto-?generated|automatically generated|this (?:file|class|code) (?:was|is) generated|code generated|do not (?:edit|modify)|generated source)`

# The project declares the runtime the generated code needs.
_runtime_declared if {
	some p, c in input.file_contents
	regex.match(`(?:^|/)(?:pom\.xml|build\.gradle(?:\.kts)?|ivy\.xml)$`, p)
	regex.match(`(?:jaxb-api|jaxb-runtime|jaxb-impl|jaxws-api|jaxws-rt|jaxws-ri|javax\.jws-api|javax\.annotation-api|javax\.activation|activation-api|saaj-api|saaj-impl|javax\.xml\.soap-api|glassfish-corba|jakarta\.xml\.bind-api|jakarta\.xml\.ws-api|jakarta\.annotation-api|jakarta\.activation)`, c)
}

# A generator header in the first lines of the file, or a @Generated annotation.
_generated(lines, content) if regex.match(`(?m)^\s*@(?:javax\.annotation\.(?:processing\.)?)?Generated\b`, content)

# The header ends at the first type declaration: a comment further down that
# merely mentions generated classes does not make the file generated.
_header_end(lines) := min([30, count(lines) - 1, min([j |
	some j, l in lines
	regex.match(`^\s*(?:(?:public|protected|private|abstract|final|static|sealed|data|open|internal)\s+)*(?:class|interface|enum|record|object)\s+\w`, l)
])])

_header_end(lines) := min([30, count(lines) - 1]) if {
	not _has_type_decl(lines)
}

_has_type_decl(lines) if {
	some l in lines
	regex.match(`^\s*(?:(?:public|protected|private|abstract|final|static|sealed|data|open|internal)\s+)*(?:class|interface|enum|record|object)\s+\w`, l)
}

_generated(lines, _) if {
	some j in numbers.range(0, _header_end(lines))
	helpers.is_comment_line(lines[j])
	regex.match(_marker_re, lines[j])
}

_code(line) := regex.replace(regex.replace(line, `"(?:[^"\\]|\\.)*"`, `""`), `//.*$`, "")

findings contains finding if {
	some path, content in input.file_contents
	regex.match(`\.(?:java|kt)$`, path)
	regex.match(_gate_re, content)
	not _runtime_declared
	lines := split(content, "\n")
	_generated(lines, content)
	some i, line in lines
	regex.match(_gate_re, line)
	not helpers.is_comment_line(line)
	regex.match(_removed_re, _code(line))
	finding := {
		"rule_id": metadata.id,
		"message": "Generated code depends on a Java EE package removed from the JDK in Java 11 (JAXB, JAX-WS, SAAJ, JAF, javax.annotation or CORBA); declare the runtime artifact in the build or regenerate against jakarta.*",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": line,
	}
}
