# SPDX-License-Identifier: Apache-2.0
package vulnetix.rules.vnx_640

import rego.v1

import data.vulnetix.helpers

metadata := {
	"id": "VNX-640",
	"name": "Weak Password Recovery Mechanism for Forgotten Password",
	"description": "Three concrete weaknesses of a forgotten-password flow are reported. (1) A predictable recovery secret: a value assigned to a reset/recovery/forgot token, code, key, hash, link or pin, an OTP or one-time code, a verification code, or a temporary or new password, generated by a non-cryptographic source (Python random.* or bare randint/randrange/choice imported from random, time.time(), uuid1(), an MD5/SHA-1/SHA-256 of the email, username, user id or time; JavaScript Math.random(), Date.now(), new Date().getTime(); Java new Random(), a java.util.Random field's next*(), ThreadLocalRandom, Math.random(), commons-lang RandomStringUtils.random*, System.currentTimeMillis()). (2) A reset link built from the request's Host header (Flask request.host/host_url/url_root, Django META['HTTP_HOST'], Express req.headers.host/req.get('host')/req.hostname, and the X-Forwarded-Host header in Python and Express, Servlet getHeader(\"Host\")/getServerName()) within 12 lines of reset/forgot/recover code and a token or link, which lets an attacker who sets the header receive the victim's reset token (password-reset poisoning). (3) A password reset decided by a security question: in a file that names a security/secret question or answer, a comparison of a stored answer with an answer taken from the request. Not reported: timestamps stored beside a token (resetPasswordExpires = Date.now() + 3600000, reset_token_created = time.time()), secrets, SystemRandom, crypto.randomBytes/randomInt, SecureRandom and UUID.randomUUID tokens, random values for non-secret purposes (jitter, retry delays), Host reads unrelated to a reset, a reset link built from configuration, Django get_host() (validated against ALLOWED_HOSTS), test code, comments and string literals.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/vnx-640/",
	"languages": ["node", "python", "java"],
	"severity": "medium",
	"level": "warning",
	"kind": "sast",
	"cwe": [640],
	"capec": ["CAPEC-66"],
	"attack_technique": ["T1190"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:M/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:M/DI:H/EX:M/EC:N/P:C",
	"tags": ["weak-password-recovery", "password-reset", "host-header-poisoning", "cwe-640"],
}

_lang(path) := "py" if endswith(path, ".py")

_lang(path) := "java" if endswith(path, ".java")

_lang(path) := "js" if {
	some ext in {".js", ".ts", ".mjs", ".cjs", ".jsx", ".tsx"}
	endswith(path, ext)
}

_blank(line) := regex.replace(regex.replace(regex.replace(line, `"(\\.|[^"\\])*"`, `""`), `'(\\.|[^'\\])*'`, `''`), "`[^`]*`", "``")


# ── (1) Predictable recovery secret ──────────────────────────────────────

# The first assignment (or object field) on the line: name and value.
_assign_re := `\b([\w.]+)\s*(?::\s*[\w<>\[\]]+\s*)?[:=]\s*([^=].*)$`

_secret_name := `(?i)^(?:\w*(?:reset|recover|forgot)\w*?(?:token|code|key|hash|link|secret|pin|otp|pass\w*|nonce)\w*|(?:\w+_)?otp\w*|(?:\w+_)?one_?time\w*|\w*verif\w*code\w*|\w*temp(?:orary)?_?pass\w*|new_?pass(?:word)?\w*|\w*pin_?code\w*)$`

_name_hint := `(?i)reset|recover|forgot|otp|one_?time|verif|temp|new_?pass|pin_?code`

_weak := {
	"py": `(?:^|[^\w.])random\.(?:random|randint|randrange|choice|choices|sample|getrandbits|uniform)\(|\btime\.time\(\)|\buuid\.?uuid1\(|\bhashlib\.(?:md5|sha1|sha256)\([^)]*(?:email|username|user_?id|time)`,
	"js": `\bMath\.random\(|\bDate\.now\(\)|\bnew\s+Date\(\)\.getTime\(\)|\+\s*new\s+Date\(\)|createHash\(\s*['"](?:md5|sha1)['"]\s*\)\.update\([^)]*(?:email|username|userId|Date\.now)`,
	"java": `\bnew\s+Random\s*\(|\bThreadLocalRandom\b|\bMath\.random\(|\bRandomStringUtils\.random\w*\(|\bSystem\.currentTimeMillis\(\)`,
}

# Cheap substrings one of which every weak source contains.
_weak_needles := {
	"py": {"random", "randint", "randrange", "choice", "time.time", "uuid1", "hashlib"},
	"js": {"Math.random", "Date", "createHash"},
	"java": {"Random", "currentTimeMillis", ".next"},
}

_strong := `SystemRandom|\bsecrets\.|randomBytes|randomInt|randomUUID|SecureRandom|getRandomValues|token_urlsafe|token_hex`

_has_needle(lang, s) if {
	some n in _weak_needles[lang]
	contains(s, n)
}

_weak_rhs(lang, _, r) if regex.match(_weak[lang], r)

# `from random import randint` makes the bare name the weak generator.
_weak_rhs("py", content, r) if {
	regex.match(`(?:^|[^\w.])(?:randint|randrange|choice|choices|getrandbits)\(`, r)
	regex.match(`(?m)^\s*from\s+random\s+import\b`, content)
}

# A java.util.Random field or local: rnd.nextInt(...).
_weak_rhs("java", content, r) if {
	some m in regex.find_all_string_submatch_n(`\b(\w+)\.next(?:Int|Long|Double|Bytes)\(`, r, -1)
	regex.match(concat("", [`\bRandom\s+`, m[1], `\s*=\s*new\s+Random\s*\(`]), content)
}

# When a reset token was issued or expires is a time, not a secret:
# resetPasswordExpires = Date.now() + 3600000.
_timestamp_name := `[Ee]xpir|_at$|[a-z]At$|[Ss]ent|[Ii]ssued|[Cc]reated|_time$|Time$|[Tt]imestamp|_date|[Dd]ate$|[Tt]tl|[Uu]ntil|_count|Count|[Aa]ttempt|[Tt]ries`

_weak_secret(lang, content, code) if {
	_has_needle(lang, code)
	regex.match(_name_hint, code)
	m := regex.find_all_string_submatch_n(_assign_re, code, 1)
	count(m) > 0
	parts := split(m[0][1], ".")
	regex.match(_secret_name, parts[count(parts) - 1])
	not regex.match(_timestamp_name, parts[count(parts) - 1])
	r := m[0][2]
	_weak_rhs(lang, content, r)
	not regex.match(_strong, r)
}

# ── (2) Reset link from the Host header ──────────────────────────────────

_host := {
	"py": `\brequest\.(?:host|host_url|url_root|META\[\s*['"]HTTP_(?:X_FORWARDED_)?HOST['"]\s*\])\b|\brequest\.headers(?:\.get\(|\[)\s*['"]X-Forwarded-Host['"]`,
	"js": `\breq\.(?:headers\.host\b|headers\[\s*['"](?:x-forwarded-)?host['"]\s*\]|get\(\s*['"](?:x-forwarded-)?host['"]\s*\)|hostname\b)`,
	"java": `\.getHeader\(\s*(?:HttpHeaders\.HOST|"[Hh]ost")\s*\)|\.getServerName\(\)`,
}

_host_link(lang, lines, i) if {
	regex.match(_host[lang], lines[i])
	_host_reaches_link(lines, i)
	regex.match(`(?i)reset|forgot|recover`, helpers.code_window(lines, i, 12, 12))
}

# The Host value is part of a link on its own line, or the variable it is
# assigned to is used with a token or link within the next 12 lines.
_host_reaches_link(lines, i) if regex.match(`(?i)token|link|reset|url\s*=|_url\b|Url\b`, regex.replace(lines[i], `(?i)host_?url|url_?root`, ""))

_host_reaches_link(lines, i) if {
	v := helpers.assigned_first(lines[i])
	some j in numbers.range(i + 1, min([count(lines) - 1, i + 12]))
	regex.match(concat("", [`\b`, v, `\b`]), lines[j])
	regex.match(`(?i)token|link|reset`, lines[j])
	not helpers.is_comment_line(lines[j])
}

# ── (3) Reset by security question ───────────────────────────────────────

_source := {
	"py": `\brequest\.(?:form|POST|json|args|values|data|GET)\b`,
	"js": `\b(?:req\.)?body\.\w+|\breq\.(?:query|params)\b`,
	"java": `\bgetParameter\s*\(|@RequestParam`,
}

_answer_cmp := `(?i)answer\w*(?:\.\w+\(\))?\s*(?:===?|!==?)|(?:===?|!==?)\s*[\w.]*answer|equals(?:IgnoreCase)?\([^)]*answer|answer\w*\.equals`

_question_reset(lang, lines, i, code) if {
	regex.match(_answer_cmp, code)
	_answer_from_request(lang, lines, i, code)
}

_answer_from_request(lang, _, _, code) if regex.match(_source[lang], code)

_answer_from_request(lang, lines, i, code) if {
	some v in helpers.tainted_names(lines, i, 30, _source[lang])
	regex.match(`(?i)answer`, v)
	regex.match(concat("", [`\b`, v, `\b`]), code)
}

# ── Findings ─────────────────────────────────────────────────────────────

_kinds(lang, content) := {k |
	some k in ["weak", "host", "question"]
	_file_may(k, lang, content)
}

_file_may("weak", lang, content) if {
	_has_needle(lang, content)
	regex.match(_name_hint, content)
}

_file_may("host", lang, content) if regex.match(_host[lang], content)

_file_may("question", _, content) if regex.match(`(?i)(?:security|secret)_?(?:question|answer)`, content)

_line_bad("weak", lang, content, _, _, line) if {
	_has_needle(lang, line)
	regex.match(_name_hint, line)
	_weak_secret(lang, content, _blank(line))
}

_line_bad("host", lang, _, lines, i, line) if {
	regex.match(_host[lang], line)
	_host_link(lang, lines, i)
}

_line_bad("question", lang, _, lines, i, line) if {
	regex.match(`(?i)answer`, line)
	code := _blank(line)
	_question_reset(lang, lines, i, code)
}

findings contains finding if {
	some path, content in input.file_contents
	lang := _lang(path)
	kinds := _kinds(lang, content)
	count(kinds) > 0
	not helpers.is_test_path(path)
	lines := split(content, "\n")
	some i, line in lines
	some k in kinds
	_line_bad(k, lang, content, lines, i, line)
	not helpers.is_comment_line(line)
	finding := {
		"rule_id": metadata.id,
		"message": "Weak password recovery: a predictable reset token/OTP/temporary password, a reset link built from the Host header, or a reset decided by a security question. Use a CSPRNG token, a configured base URL and an emailed single-use link",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": line,
	}
}
