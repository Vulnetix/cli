# SPDX-License-Identifier: Apache-2.0
package vulnetix.rules.vnx_1080

import rego.v1

import data.vulnetix.helpers

metadata := {
	"id": "VNX-1080",
	"name": "Source Code File with Excessive Number of Lines of Code",
	"description": "A hand-written Python source file holding more than 2000 lines of code (lines that are neither blank nor a # comment; docstrings count as code). A module that large is hard to review, so a security-relevant change in it is easy to miss. One finding per file, at its first line of code. Not reported: files of 2000 code lines or fewer, test files, generated code (protobuf/gRPC stubs, Django migrations, files whose first 1000 characters carry a 'Generated by', '@generated', 'autogenerated' or 'DO NOT EDIT' marker on a comment line or opening the module docstring; prose that only mentions generated values does not exempt a file), third-party trees (site-packages, vendor, node_modules, .venv) and setuptools build/lib copies.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/vnx-1080/",
	"languages": ["python"],
	"severity": "low",
	"level": "note",
	"kind": "sast",
	"cwe": [1080],
	"capec": ["CAPEC-66"],
	"attack_technique": ["T1190"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:L/AP:RU/AL:S/IC:N/FC:LT/RP:RU/RL:S/AV:L/AS:N/IN:A/SC:A/BI:L/DI:H/EX:L/EC:N/P:L",
	"tags": ["excessive-file-length", "maintainability", "cwe-1080"],
}

_max_code_lines := 2000

_generated_path(path) if regex.match(`(_pb2|_pb2_grpc)\.pyi?$`, path)

_generated_path(path) if regex.match(`(^|/)migrations/[^/]+\.py$`, path)

_generated_path(path) if regex.match(`(^|/)(site-packages|dist-packages|vendor|third_party|node_modules|\.venv|venv)/`, path)

# setuptools build output: a copy of the package, not a second module to review.
_generated_path(path) if regex.match(`(^|/)build/lib(\.[^/]+)?/`, path)

_generated_header(content) if {
	head := substring(content, 0, 1000)
	# A generator marker on a comment line, or opening the module docstring;
	# prose that merely mentions "auto-generated" values does not count.
	regex.match(`(?im)^[ \t]*(?:#.*|(?:"""|''')[ \t]*)(?:generated by|@generated|do not edit|autogenerated|auto-generated|automatically generated|code generated)`, head)
}

_is_code(line) if {
	t := trim_space(line)
	t != ""
	not startswith(t, "#")
}

findings contains finding if {
	some path, content in input.file_contents
	endswith(path, ".py")
	# cheap whole-file gate: more raw lines than the code-line limit
	count(indexof_n(content, "\n")) > _max_code_lines
	not helpers.is_test_path(path)
	not _generated_path(path)
	not _generated_header(content)
	lines := split(content, "\n")
	code := [i | some i, line in lines; _is_code(line)]
	n := count(code)
	n > _max_code_lines
	first := code[0]
	finding := {
		"rule_id": metadata.id,
		"message": sprintf("Python module has %d lines of code (limit %d); split it into smaller modules so changes to it can be reviewed", [n, _max_code_lines]),
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": first + 1,
		"snippet": lines[first],
	}
}
