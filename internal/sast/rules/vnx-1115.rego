# SPDX-License-Identifier: Apache-2.0
package vulnetix.rules.vnx_1115

import rego.v1

import data.vulnetix.helpers

metadata := {
	"id": "VNX-1115",
	"name": "Source Code Element without Standard Prologue",
	"description": "A source file that lacks the licence/copyright prologue the rest of the project's files of the same language carry. The project standard is established from the scanned files themselves: at least four files of the language have a prologue (SPDX-License-Identifier, Copyright, (c) followed by a year, ©, 'Licensed under', 'Licensed to the' (the ASF header), 'under the Apache License', 'License:' or 'All rights reserved' in the first 3000 characters, or anywhere in a longer leading comment block) and at least 80% of that language's files do. Each file without one is reported once, at its first line of code. Languages: C, C++, Go, Java, JavaScript/TypeScript, Python and Rust. Not reported: projects with no prevailing prologue, test files, minified files, empty files, generated files (a 'Code generated', '@generated', 'DO NOT EDIT', 'autogenerated', 'automatically generated' or 'generated by' marker near the top), vendored and third-party trees (vendor, third_party, node_modules, Pods, Carthage, .venv, site-packages, deps) and test fixtures under testdata/fixtures.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/vnx-1115/",
	"languages": ["c", "cpp", "go", "java", "javascript", "python", "rust"],
	"severity": "low",
	"level": "note",
	"kind": "sast",
	"cwe": [1115],
	"capec": ["CAPEC-66"],
	"attack_technique": ["T1190"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:L/AP:RU/AL:S/IC:N/FC:LT/RP:RU/RL:S/AV:L/AS:N/IN:A/SC:A/BI:L/DI:H/EX:L/EC:N/P:L",
	"tags": ["missing-prologue", "license-header", "cwe-1115"],
}

_min_with := 4

_family(path) := "c" if regex.match(`\.(c|h|cc|cpp|cxx|hpp|hh|hxx)$`, path)

_family(path) := "go" if endswith(path, ".go")

_family(path) := "java" if endswith(path, ".java")

_family(path) := "js" if regex.match(`\.(js|jsx|mjs|cjs|ts|tsx|mts|cts)$`, path)

_family(path) := "py" if endswith(path, ".py")

_family(path) := "rs" if endswith(path, ".rs")

_excluded(path) if regex.match(`(?i)(^|/)(vendor|third_party|third-party|thirdparty|node_modules|\.venv|venv|site-packages|dist-packages|deps|Pods|Carthage|bower_components|testdata|fixtures?|__fixtures__|dist|build)/`, path)

_excluded(path) if regex.match(`\.(min\.js|d\.ts|pb\.go|pb\.cc|pb\.h)$|_pb2\.py$`, path)

_head(content) := lower(substring(content, 0, 3000))

_generated_words := ["code generated", "@generated", "do not edit", "autogenerated", "auto-generated", "automatically generated", "generated by"]

_prologue_words := ["spdx-license-identifier", "copyright", "(c) 19", "(c) 20", "(c)19", "(c)20", "©", "licensed under", "licensed to the", "under the apache license", "license:", "all rights reserved"]

_generated(head) if {
	some w in _generated_words
	contains(head, w)
}

_has_prologue(head) if {
	some w in _prologue_words
	contains(head, w)
}

# files that take part in the project standard, by language family
_candidates := {[fam, path, has] |
	some path, content in input.file_contents
	fam := _family(path)
	not _excluded(path)
	not helpers.is_test_path(path)
	head := _head(content)
	trim_space(head) != ""
	not _generated(head)
	has := _flag(fam, content, head)
}

_flag(_, _, head) := true if _has_prologue(head)

# a long leading comment can carry the notice past the first 3000 characters
_flag(fam, content, head) := true if {
	not _has_prologue(head)
	_lead_prologue(fam, content)
}

_flag(fam, content, head) := false if {
	not _has_prologue(head)
	not _lead_prologue(fam, content)
}

_lead_prologue(fam, content) if {
	count(content) > 3000
	lead := regex.find_n(_leading[fam], substring(content, 0, 12000), 1)[0]
	count(lead) > 3000
	_has_prologue(lower(lead))
}

_with := {fam: n |
	some fam in {f | some [f, _, _] in _candidates}
	n := count({p | some [f, p, true] in _candidates; f == fam})
}

_total := {fam: n |
	some fam in {f | some [f, _, _] in _candidates}
	n := count({p | some [f, p, _] in _candidates; f == fam})
}

_standard(fam) if {
	_with[fam] >= _min_with
	_with[fam] * 5 >= _total[fam] * 4
}

# leading whitespace and comments, per comment syntax
_c_lead := `^(?:\s+|//[^\n]*|/\*(?s:.*?)\*/)*`

_leading := {"c": _c_lead, "go": _c_lead, "java": _c_lead, "js": _c_lead, "rs": _c_lead, "py": `^(?:\s+|#[^\n]*)*`}

findings contains finding if {
	some [fam, path, false] in _candidates
	_standard(fam)
	content := input.file_contents[path]
	head := substring(content, 0, 4000)
	lead := regex.find_n(_leading[fam], head, 1)[0]
	count(lead) < count(head)
	i := count(indexof_n(lead, "\n"))
	lines := split(head, "\n")
	count(lines[i]) < 300
	finding := {
		"rule_id": metadata.id,
		"message": sprintf("File has no licence/copyright prologue, unlike %d of the project's %d files in this language; add the project's standard header", [_with[fam], _total[fam]]),
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": lines[i],
	}
}

