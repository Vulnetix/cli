	secrets.high_entropy(token, 3.5)
	finding := {
		"rule_id": metadata.id,
		"message": "PrestaShop webservice key found; delete it under Advanced Parameters \u003e Webservice and generate a new key",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
