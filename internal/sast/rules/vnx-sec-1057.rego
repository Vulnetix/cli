# GENERATED by internal/sast/secretsgen from catalog.json — do not edit by hand.

metadata := {
	"id": "VNX-SEC-1057",
	"name": "Rapid7 InsightVM/InsightAppSec API key (assignment)",
	"description": "A Rapid7 Insight platform API key (UUID) assigned to a rapid7/insightvm field was found. It grants programmatic access to InsightVM/InsightAppSec scan data and platform APIs.",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/secrets/saas/#vnx-sec-1057",
	"languages": [],
	"severity": "high",
	"level": "error",
	"kind": "secrets",
	"cwe": [798],
	"capec": ["CAPEC-191"],
	"attack_technique": ["T1552.001"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:H/AP:A/AL:A/IC:N/FC:LT/RP:N/RL:A/AV:I/AS:N/IN:A/SC:A/BI:H/DI:H/EX:H/EC:N/P:H",
	"tags": ["secrets", "rapid7", "saas"],
}

_pattern := `(?i)(?:rapid7|insightvm|insightappsec|insight)[a-z0-9_]*(?:api[_-]?key|key|token)\s*[:=]\s*['"]?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})['"]?`
_keywords := ["rapid7", "insight", "key"]

# The vulnetix.* builtins are what secrets.has_keyword, keyword_lines and
# pattern_lines call. They are called directly because a Rego function call
# hashes its arguments for its memo, and here an argument is the whole file.
findings contains finding if {
	some path, content in input.file_contents
	not secrets.skip_path(path)
	vulnetix.contains_any_fold(content, _keywords)
	some i, line in vulnetix.keyword_lines(content, _keywords)
	m := regex.find_all_string_submatch_n(_pattern, line, 1)
	count(m) > 0
	token := m[0][1]
	not secrets.is_example_token(token)
	secrets.high_entropy(token, 3.5)
	finding := {
		"rule_id": metadata.id,
		"message": "Rapid7 Insight API key found; revoke it in the Insight platform under API Keys",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": secrets.redact(line),
	}
}
