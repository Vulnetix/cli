# SPDX-License-Identifier: Apache-2.0
package vulnetix.rules.vnx_391

import rego.v1

import data.vulnetix.helpers

metadata := {
	"id": "VNX-391",
	"name": "Unchecked Error Condition",
	"description": "An exception is caught and silently discarded. In Java: a catch block whose body holds only a TODO/FIXME or auto-generated comment (with blanks or a discarded e.toString()/e.getMessage() call), or an empty or no-op body longer than VNX-390 looks. A Java catch that is plainly empty (on one line, across a few blank lines, or Allman style) or whose only statement is a discarded e.toString()/e.getMessage() is reported by VNX-390 instead, the same defect under CWE-390, so it is one finding. In Python: a bare except:, except Exception or except BaseException (alone or in a tuple) whose whole body is pass or an ellipsis, on the same line or below. The failure is lost: the caller continues as if the operation succeeded. Not reported: a catch or except that logs, rethrows, returns or records anything; a Java catch variable named ignored/ignore/expected/unused (an explicit discard); a body holding an explanatory comment, or a Python pass carrying a trailing comment other than TODO/FIXME (# nosec, # noqa, a reason), or an except line carrying one (a documented decision); a Python except of a specific exception type such as ImportError or KeyError; contextlib.suppress; test files, comments and string literals (a quoted catch clause is not matched).",
	"help_uri": "https://docs.cli.vulnetix.com/docs/sast-rules/vnx-391/",
	"languages": ["java", "python"],
	"severity": "medium",
	"level": "warning",
	"kind": "sast",
	"cwe": [391],
	"capec": ["CAPEC-66"],
	"attack_technique": ["T1190"],
	"cvssv4": "",
	"cwss": "CWSS:1.0/TI:M/AP:RU/AL:S/IC:N/FC:LT/RP:RU/RL:S/AV:L/AS:N/IN:A/SC:A/BI:M/DI:H/EX:M/EC:N/P:C",
	"tags": ["error-handling", "cwe-391"],
}

_indent(line) := count(line) - count(trim_left(line, " \t"))

# Blank out string literals so a quoted catch clause is not matched.
_strip_strings(line) := regex.replace(line, `"(?:[^"\\]|\\.)*"`, `""`)

# ── Java ────────────────────────────────────────────────────────────────

# catch clause opening a block on this line; group 1 is the variable name,
# group 2 whatever follows the opening brace.
_java_catch_re := `\bcatch\s*\(\s*(?:final\s+)?[\w.]+(?:\s*\|\s*[\w.]+)*\s+(\w+)\s*\)\s*\{(.*)$`

_discard_var(v) if regex.match(`^(?i:ignored?|expected|unused|_+)$`, v)

# A comment that records no decision.
_empty_comment(l) if regex.match(`^\s*(?://|/\*|\*)\s*(?i:todo|fixme|auto-generated|autogenerated)?\W*$`, l)

_empty_comment(l) if regex.match(`^\s*(?://|/\*|\*)\s*(?i:todo|fixme)\b.*$`, l)

_empty_comment(l) if regex.match(`(?i)^\s*(?://|/\*|\*)\s*auto-?generated catch block.*$`, l)

# The body line is a no-op: blank, a non-decision comment, or e.toString();
_java_noop(l, _) if trim_space(l) == ""

_java_noop(l, _) if _empty_comment(l)

_java_noop(l, v) if regex.match(concat("", [`^\s*`, v, `\.(?:toString|getMessage|getLocalizedMessage)\(\)\s*;\s*$`]), l)

# One-line form: catch (E e) {} or catch (E e) { } with nothing else.
_java_empty(lines, i, m) if {
	regex.match(`^\s*\}`, m[2])
}

# Multi-line form: the brace closes within a few lines and every line in
# between is a no-op.
_java_empty(lines, i, m) if {
	trim_space(m[2]) == ""
	ends := [k |
		some k in numbers.range(i + 1, min([count(lines) - 1, i + 6]))
		k > i
		regex.match(`^\s*\}`, lines[k])
	]
	count(ends) > 0
	k := ends[0]
	bad := [j |
		some j in numbers.range(i + 1, k)
		j < k
		not _java_noop(lines[j], m[1])
	]
	count(bad) == 0
}

# Allman form: the catch clause ends its line and the brace opens the next.
_java_allman_re := `\bcatch\s*\(\s*(?:final\s+)?[\w.]+(?:\s*\|\s*[\w.]+)*\s+(\w+)\s*\)\s*$`

_java_match(_, i, line) := m if {
	ms := regex.find_all_string_submatch_n(_java_catch_re, _strip_strings(line), 1)
	count(ms) > 0
	m := {"var": ms[0][1], "at": i, "m": ms[0]}
}

_java_match(lines, i, line) := m if {
	ms := regex.find_all_string_submatch_n(_java_allman_re, _strip_strings(line), 1)
	count(ms) > 0
	i + 1 < count(lines)
	trim_space(lines[i + 1]) == "{"
	m := {"var": ms[0][1], "at": i + 1, "m": [ms[0][0], ms[0][1], ""]}
}

findings contains finding if {
	some path, content in input.file_contents
	endswith(path, ".java")
	contains(content, "catch")
	not helpers.is_test_path(path)
	lines := split(content, "\n")
	some i, line in lines
	contains(line, "catch")
	not helpers.is_comment_line(line)
	jm := _java_match(lines, i, line)
	not _discard_var(jm.var)
	_java_empty(lines, jm.at, jm.m)
	not _vnx390_reports(lines, i, _strip_strings(line))
	finding := {
		"rule_id": metadata.id,
		"message": "Exception caught and silently discarded: the empty catch block hides the failure and the caller continues as if it succeeded. Handle, log or rethrow it",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": line,
	}
}

# ── Handed over to VNX-390 ──────────────────────────────────────────────
# VNX-390 (CWE-390, Detection of Error Condition Without Action) reports a
# Java catch whose body is empty or only discards e.toString()/getMessage().
# That is the same defect, so those catches are its, and this rule keeps the
# Java shapes VNX-390 does not report: a body holding only a TODO/FIXME or
# auto-generated comment, and the longer blank or no-op bodies beyond its
# window. The predicates below are VNX-390's own.

_v390_catch_re := `^(?:.*[};])?\s*catch\s*\(\s*(?:final\s+)?[\w.$|\s]+?\s+(\w+)\s*\)\s*\{(.*)$`

_v390_allman_re := `^(?:.*[};])?\s*catch\s*\(\s*(?:final\s+)?[\w.$|\s]+?\s+(\w+)\s*\)\s*$`

_v390_deliberate := {"ignored", "ignore", "ignoredException", "expected", "unused", "_", "ignore_"}

_v390_discard := `\s*\.\s*(?:toString|getMessage|getLocalizedMessage|getCause)\s*\(\s*\)\s*;\s*`

_v390_next(lines, i) := j if {
	end := min([count(lines) - 1, i + 4])
	end >= i + 1
	cands := [k | some k in numbers.range(i + 1, end); trim_space(lines[k]) != ""]
	count(cands) > 0
	j := cands[0]
}

_v390_catch(_, i, line) := [m[0][1], i, m[0][2]] if {
	m := regex.find_all_string_submatch_n(_v390_catch_re, line, 1)
	count(m) > 0
}

_v390_catch(lines, i, line) := [m[0][1], j, b[0][1]] if {
	m := regex.find_all_string_submatch_n(_v390_allman_re, line, 1)
	count(m) > 0
	j := _v390_next(lines, i)
	b := regex.find_all_string_submatch_n(`^\s*\{(.*)$`, _strip_strings(lines[j]), 1)
	count(b) > 0
}

_v390_empty(_, _, _, rest) if regex.match(`^\s*\}`, rest)

_v390_empty(lines, i, _, rest) if {
	trim_space(rest) == ""
	regex.match(`^\s*\}`, lines[_v390_next(lines, i)])
}

_v390_empty(_, _, v, rest) if regex.match(concat("", [`^\s*`, v, _v390_discard, `\}`]), rest)

_v390_empty(lines, i, v, rest) if {
	trim_space(rest) == ""
	j := _v390_next(lines, i)
	regex.match(concat("", [`^\s*`, v, _v390_discard, `$`]), lines[j])
	regex.match(`^\s*\}`, lines[_v390_next(lines, j)])
}

_vnx390_reports(lines, i, line) if {
	c := _v390_catch(lines, i, line)
	not _v390_deliberate[c[0]]
	_v390_empty(lines, c[1], c[0], c[2])
}

# ── Python ──────────────────────────────────────────────────────────────

# bare except, or a broad Exception/BaseException alone or in a tuple;
# group 1 is what follows the colon on the same line.
_py_except_re := `^\s*except\s*(?:\(\s*(?:[\w.]+\s*,\s*)*(?:builtins\.)?(?:Base)?Exception\s*(?:,\s*[\w.]+\s*)*\)|(?:builtins\.)?(?:Base)?Exception)?\s*(?:as\s+\w+\s*)?:(.*)$`

# pass or ..., bare or with a TODO/FIXME comment. Any other trailing comment
# (an explanation, # nosec, # noqa) records a decision, as a comment line in
# the body does.
_py_noop(s) if regex.match(`^\s*(?:pass|\.\.\.)\s*(?:#\s*(?i:todo|fixme)\b.*|#\s*)?$`, s)

# except Exception: pass
_py_swallow(lines, i, m) if _py_noop(m[1])

# except Exception:\n    pass   (pass is the whole body)
_py_swallow(lines, i, m) if {
	trim_space(m[1]) == ""
	ie := _indent(lines[i])
	body := [k |
		some k in numbers.range(i + 1, min([count(lines) - 1, i + 6]))
		k > i
		trim_space(lines[k]) != ""
	]
	count(body) > 0
	first := body[0]
	_indent(lines[first]) > ie
	_py_noop(lines[first])
	not _py_more_body(lines, first, ie)
}

# The body continues past pass: the next non-blank line is still deeper than
# the except (a line at the except's indent or shallower ends the block).
_py_more_body(lines, first, ie) if {
	rest := [k |
		some k in numbers.range(first + 1, min([count(lines) - 1, first + 4]))
		k > first
		trim_space(lines[k]) != ""
	]
	count(rest) > 0
	_indent(lines[rest[0]]) > ie
}

# The line sits inside a triple-quoted string (an odd number of delimiters
# above it).
_in_docstring(lines, i) if {
	above := concat("\n", array.slice(lines, 0, i))
	n := count(indexof_n(above, `"""`)) + count(indexof_n(above, "'''"))
	n % 2 == 1
}

findings contains finding if {
	some path, content in input.file_contents
	endswith(path, ".py")
	contains(content, "except")
	not helpers.is_test_path(path)
	lines := split(content, "\n")
	some i, line in lines
	startswith(trim_space(line), "except")
	ms := regex.find_all_string_submatch_n(_py_except_re, line, 1)
	count(ms) > 0
	_py_swallow(lines, i, ms[0])
	not _in_docstring(lines, i)
	finding := {
		"rule_id": metadata.id,
		"message": "Broad except whose only body is pass: every failure, including programming errors, is silently discarded. Catch the specific exception and handle or log it",
		"artifact_uri": path,
		"severity": metadata.severity,
		"level": metadata.level,
		"start_line": i + 1,
		"snippet": line,
	}
}
